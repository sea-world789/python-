#判断年份是否为闰年 tips:闰年能被4但不能被100整除 也能被400整除
def r_years(years):
    if (years%4==0 and years%100!=0) or (years%400==0):
        return True
    else:
        return False
def main():
    years = r_years(int(input("请输入年份")))
    if r_years(years):
        print("闰年")
    else:
        print("不是闰年")


if __name__ =="__main__":
    main()
